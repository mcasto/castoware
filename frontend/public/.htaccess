DirectoryIndex index.html

<IfModule mod_headers.c>
  # Build assets have content hashes in their names, so they never change
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Always revalidate the entry point so new deploys are picked up
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>

RewriteEngine On

# 1. Handle static files first
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Explicit API routing (must come first)
RewriteRule ^api/(.*)$ index.php [L]

# 3. All other requests to index.html
RewriteRule ^ index.html [L]
